# From the developer portal (https://app.acinch.com/developers). Never commit the filled-in .env.
ACINCH_BASE_URL=https://app.acinch.com
ACINCH_CLIENT_ID=
ACINCH_CLIENT_SECRET=
ACINCH_INSTALLATION_ID=

# webhook-push: the incoming webhook URL (it is the credential)
ACINCH_HOOK_URL=

# approval-card: the app's signing secret (acinch_ss_...), and who approves
ACINCH_SIGNING_SECRET=
APPROVERS=
PORT=3000
